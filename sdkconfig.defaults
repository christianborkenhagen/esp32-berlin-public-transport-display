# CrowPanel Advance 5.0 V1.1 uses an ESP32-S3-WROOM-1-N16R8:
# 16 MB QIO flash and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Match Elecrow's V1.1 CPU/cache-line settings for RGB bounce-buffer scanout.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Per-core idle-task runtime counters for the benchmark's CPU estimate.
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U32=y

# Keep the test image and future application data in a project-owned table.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL 9 configuration (the panel uses RGB565).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
# Run LVGL's software drawing workers in parallel on the two cores.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# This ESP-IDF Xtensa port uses a one-byte StackType_t, so LVGL 9.4's
# FreeRTOS wrapper allocates this many bytes for each worker stack.
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
# Move LVGL's marked hot drawing functions to internal instruction RAM.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

# Use the driver's automatic recovery rather than restarting at every VSYNC.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=n
