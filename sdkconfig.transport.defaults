# Leave enough internal RAM for the LCD, LVGL, and Wi-Fi tasks.
CONFIG_LV_DRAW_THREAD_STACK_SIZE=8192
# Reserve more internal DMA-capable RAM for Wi-Fi; the app adds a PSRAM pool.
CONFIG_LV_MEM_SIZE_KILOBYTES=32
# LVGL's TLSF allocator must allow the explicitly added 256 KiB PSRAM pool.
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=256
# The widgets demo requires a larger internal pool and is not used here.
CONFIG_LV_USE_DEMO_WIDGETS=n

# The full-size TLS receive buffer did not fit in the available internal heap.
# This moves mbedTLS dynamic allocations to external PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ESP-IDF's hardware AES path allocates DMA memory for each operation.
# With the display and Wi-Fi running, those allocations can fail during NVS
# encryption. Software AES keeps the same AES-XTS on-flash format.
CONFIG_MBEDTLS_HARDWARE_AES=n

# Prefer external RAM for Wi-Fi/lwIP allocations where supported. Keep the
# internal static receive buffers and matching aggregation window small.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# C layouts use widget names to bind controllers and simulator tests.
CONFIG_LV_USE_XML=n
CONFIG_LV_USE_OBJ_NAME=y
# LVGL 9.4's span widget needs observer types even when XML is disabled.
CONFIG_LV_USE_OBSERVER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
